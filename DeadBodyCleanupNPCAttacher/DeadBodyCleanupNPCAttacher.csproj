<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Utilizando o wildcard '*' para garantir que vai puxar sempre a build compatível mais recente suportada pelo Synthesis -->
    <PackageReference Include="Mutagen.Bethesda" Version="*" />
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="*" />
  </ItemGroup>
</Project>
