<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Substitua pela versão exata instalada no seu ambiente (ex: 0.36.0 ou 0.37.0).
         O Synthesis ajusta automaticamente essa versão durante o build na interface dele,
         mas fixar um número garante builds reproduzíveis fora do Synthesis. -->
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.0" />
  </ItemGroup>
</Project>
